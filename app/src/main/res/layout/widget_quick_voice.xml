<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_quick_voice_bg"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/widget_compact"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:contentDescription="@string/widget_quick_voice_title">
        <TextView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_quick_voice_mark"
            android:gravity="center"
            android:text="Q"
            android:textColor="@color/widget_on_accent"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/widget_quick_voice_title"
            android:textColor="@color/widget_ink"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="🎙"
            android:textSize="22sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_wide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        android:contentDescription="@string/widget_quick_voice_title">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_quick_voice_prompt"
                android:textColor="@color/widget_ink"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/widget_quick_voice_hint"
                android:textColor="@color/widget_muted"
                android:textSize="11sp" />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/widget_quick_voice_button"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="@string/widget_quick_voice_tap_label"
            android:textColor="@color/widget_on_accent"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_large"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        android:contentDescription="@string/widget_quick_voice_title">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="QUSIN"
                android:textColor="@color/widget_ink"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_quick_voice_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="@string/widget_quick_voice_ready"
                android:textColor="@color/widget_accent"
                android:textSize="10sp" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/widget_quick_voice_prompt"
            android:textColor="@color/widget_ink"
            android:textSize="16sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/widget_large_speak"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/widget_quick_voice_button"
                android:gravity="center"
                android:text="@string/widget_quick_voice_tap_label"
                android:textColor="@color/widget_on_accent"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_large_type"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/widget_quick_voice_secondary"
                android:gravity="center"
                android:text="@string/widget_quick_voice_type"
                android:textColor="@color/widget_ink"
                android:textSize="13sp" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/widget_quick_voice_review_hint"
            android:textColor="@color/widget_muted"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
