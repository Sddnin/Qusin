<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_quick_voice_bg"
    android:contentDescription="@string/widget_quick_voice_title"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/widget_compact"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_quick_voice_title"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/widget_compact_logo"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/widget_quick_voice_title"
            android:scaleType="centerCrop"
            android:src="@drawable/qusin_launcher_art" />
        <TextView
            android:id="@+id/widget_compact_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_quick_voice_title"
            android:textColor="@color/widget_ink"
            android:textSize="13sp"
            android:textStyle="bold" />
        <ImageView
            android:id="@+id/widget_compact_mic"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_quick_voice_button"
            android:contentDescription="@string/widget_quick_voice_tap_label"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_quick_voice_mic" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_wide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_quick_voice_title"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_quick_voice_prompt"
                android:textColor="@color/widget_ink"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:text="@string/widget_quick_voice_hint"
                android:textColor="@color/widget_muted"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/widget_quick_voice_button"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/widget_quick_voice_tap_label"
                android:src="@drawable/widget_quick_voice_mic" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/widget_quick_voice_tap_label"
                android:textColor="@color/widget_on_accent"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_large"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_quick_voice_title"
        android:orientation="vertical"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/widget_quick_voice_title"
                android:scaleType="centerCrop"
                android:src="@drawable/qusin_launcher_art" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/app_name"
                android:textColor="@color/widget_ink"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="2"
            android:text="@string/widget_quick_voice_prompt"
            android:textColor="@color/widget_ink"
            android:textSize="18sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/widget_large_speak"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.4"
                android:background="@drawable/widget_quick_voice_button"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/widget_quick_voice_tap_label"
                    android:src="@drawable/widget_quick_voice_mic" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/widget_quick_voice_tap_label"
                    android:textColor="@color/widget_on_accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <TextView
                android:id="@+id/widget_large_type"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/widget_quick_voice_secondary"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:text="@string/widget_quick_voice_type"
                android:textColor="@color/widget_ink"
                android:textSize="13sp" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:maxLines="2"
            android:text="@string/widget_quick_voice_review_hint"
            android:textColor="@color/widget_muted"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
